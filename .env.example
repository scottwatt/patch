# Anthropic API key for the triage endpoint.
# Without this, the site falls back to keyword-based matching (still works, just dumber).
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Places API key for fetching contractor hours and reviews at build time.
# Without this, partner detail pages just show the basic info (no hours/reviews cards).
# See docs/google-places-setup.md for setup instructions.
GOOGLE_PLACES_API_KEY=

# Resend API key for emailing lead form submissions (contractor signups).
# Without this, leads are still saved locally but no email is sent.
# Get a key at https://resend.com/ (free tier covers a few hundred emails/month).
RESEND_API_KEY=

# Optional: email address that lead notifications go to. Defaults to scottwattenbarger@gmail.com.
LEAD_NOTIFICATION_EMAIL=scottwattenbarger@gmail.com
