---
import Layout from '../../layouts/Layout.astro';
import Stars from '../../components/Stars.astro';
import { trades, tradeBySlug } from '../../data/trades';
import { partnersByTrade } from '../../data/partners';

export async function getStaticPaths() {
  return trades.map((t) => ({ params: { trade: t.slug } }));
}

export const prerender = true;

const { trade: slug } = Astro.params;
const trade = tradeBySlug(slug!);

if (!trade) {
  return Astro.redirect('/');
}

const tradePartners = partnersByTrade(trade.slug);
const featured = tradePartners.filter((p) => p.tier === 'featured');
const standard = tradePartners.filter((p) => p.tier !== 'featured');
const title = `Bakersfield ${trade.name}. Local contractors | patchly`;
const description = `${trade.description} Common: ${trade.commonProblems.slice(0, 3).join(', ')}.`;
---

<Layout title={title} description={description}>
  <section class="bg-white border-b border-line">
    <div class="max-w-4xl mx-auto px-4 py-10">
      <a href="/" class="text-sm text-muted hover:text-accent">← Back</a>
      <h1 class="text-3xl sm:text-4xl font-bold mt-3 tracking-tight text-brand">
        Bakersfield {trade.name}
      </h1>
      <p class="text-lg text-muted mt-2">{trade.tagline}</p>
      <p class="text-base text-ink/80 mt-4 max-w-2xl">{trade.description}</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 py-10">
    {tradePartners.length === 0 ? (
      <div class="bg-white border border-line rounded-xl p-6 text-center">
        <p class="text-ink/70 mb-2">We're onboarding {trade.name.toLowerCase()} contractors now.</p>
        <a href="/partners" class="text-accent underline">Are you a {trade.name.toLowerCase()} contractor?</a>
      </div>
    ) : (
      <div class="space-y-6">
        {featured.length > 0 && (
          <div>
            <div class="text-xs uppercase tracking-wider text-muted px-1 mb-2">Featured</div>
            <div class="space-y-3">
              {featured.map((p) => (
                <div class="bg-white border border-accent/30 ring-1 ring-accent/10 rounded-xl p-5 hover:shadow-md transition">
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-1.5 flex-wrap mb-2">
                        <span class="text-[10px] uppercase tracking-wider font-semibold bg-accent text-white px-2 py-0.5 rounded">Featured</span>
                        {p.licensed && <span class="text-[10px] uppercase tracking-wider font-medium bg-soft text-muted px-2 py-0.5 rounded">Licensed</span>}
                        {p.insured && <span class="text-[10px] uppercase tracking-wider font-medium bg-soft text-muted px-2 py-0.5 rounded">Insured</span>}
                        {p.open24Hours && <span class="text-[10px] uppercase tracking-wider font-medium bg-accent/10 text-accent px-2 py-0.5 rounded">24/7</span>}
                        {p.freeEstimates && <span class="text-[10px] uppercase tracking-wider font-medium bg-accent/10 text-accent px-2 py-0.5 rounded">Free Estimates</span>}
                        {p.yearsInBusiness && <span class="text-[10px] uppercase tracking-wider font-medium bg-soft text-muted px-2 py-0.5 rounded">{p.yearsInBusiness}+ yrs</span>}
                      </div>
                      <a href={`/pros/${p.id}`} class="font-semibold text-lg text-brand hover:text-accent">{p.name}</a>
                      {p.rating && (
                        <div class="mt-1">
                          <Stars rating={p.rating} reviewCount={p.reviewCount} />
                        </div>
                      )}
                      <p class="text-sm text-ink/70 mt-1.5">{p.blurb}</p>
                      <p class="text-xs text-muted mt-1">{p.serviceArea}</p>
                      <a href={`/pros/${p.id}`} class="text-xs text-accent hover:text-accent-dark inline-block mt-2">View profile and reviews →</a>
                    </div>
                    <a href={`tel:${p.phone.replace(/[^0-9+]/g, '')}`} class="bg-accent hover:bg-accent-dark text-white font-medium px-4 py-2.5 rounded-lg text-center whitespace-nowrap">
                      Call {p.phone}
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {standard.length > 0 && (
          <div>
            {featured.length > 0 && (
              <div class="text-xs uppercase tracking-wider text-muted px-1 mb-2">More {trade.name.toLowerCase()} contractors</div>
            )}
            <div class="space-y-3">
              {standard.map((p) => (
                <div class="bg-white border border-line rounded-xl p-5 hover:shadow-md transition">
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-1.5 flex-wrap mb-2">
                        {p.licensed && <span class="text-[10px] uppercase tracking-wider font-medium bg-soft text-muted px-2 py-0.5 rounded">Licensed</span>}
                        {p.insured && <span class="text-[10px] uppercase tracking-wider font-medium bg-soft text-muted px-2 py-0.5 rounded">Insured</span>}
                        {p.open24Hours && <span class="text-[10px] uppercase tracking-wider font-medium bg-accent/10 text-accent px-2 py-0.5 rounded">24/7</span>}
                        {p.freeEstimates && <span class="text-[10px] uppercase tracking-wider font-medium bg-accent/10 text-accent px-2 py-0.5 rounded">Free Estimates</span>}
                        {p.yearsInBusiness && <span class="text-[10px] uppercase tracking-wider font-medium bg-soft text-muted px-2 py-0.5 rounded">{p.yearsInBusiness}+ yrs</span>}
                      </div>
                      <a href={`/pros/${p.id}`} class="font-semibold text-lg text-brand hover:text-accent">{p.name}</a>
                      {p.rating && (
                        <div class="mt-1">
                          <Stars rating={p.rating} reviewCount={p.reviewCount} />
                        </div>
                      )}
                      <p class="text-sm text-ink/70 mt-1.5">{p.blurb}</p>
                      <p class="text-xs text-muted mt-1">{p.serviceArea}</p>
                      <a href={`/pros/${p.id}`} class="text-xs text-accent hover:text-accent-dark inline-block mt-2">View profile and reviews →</a>
                    </div>
                    <a href={`tel:${p.phone.replace(/[^0-9+]/g, '')}`} class="bg-accent hover:bg-accent-dark text-white font-medium px-4 py-2.5 rounded-lg text-center whitespace-nowrap">
                      Call {p.phone}
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )}
  </section>

  <section class="max-w-4xl mx-auto px-4 py-10">
    <h2 class="text-xl font-bold mb-4 text-brand">Common {trade.name.toLowerCase()} problems</h2>
    <ul class="grid sm:grid-cols-2 gap-2">
      {trade.commonProblems.map((p) => (
        <li class="bg-white border border-line rounded-lg px-3 py-2 text-sm text-ink/70">{p}</li>
      ))}
    </ul>
  </section>
</Layout>
